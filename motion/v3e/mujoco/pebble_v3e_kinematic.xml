<mujoco model="Pebble V3-E kinematic motion proof">
  <compiler angle="degree" meshdir="assets"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.75 0.75 0.75" specular="0.25 0.25 0.25"/>
    <rgba haze="0.15 0.15 0.15 1"/>
  </visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.22 0.22 0.22" rgb2="0.28 0.28 0.28"/>
    <material name="floor_mat" texture="grid" texrepeat="8 8" reflectance="0.08"/>
    <material name="shell_mat" rgba="0.93 0.90 0.84 0.35"/>
    <material name="visor_mat" rgba="0.025 0.03 0.04 1" specular="0.7" shininess="0.7"/>
    <material name="antenna_mat" rgba="0.10 0.10 0.11 1"/>
    <material name="tip_mat" rgba="1.0 0.75 0.34 1" emission="0.25"/>
    <mesh name="shell" file="shell.stl" scale="0.001 0.001 0.001"/>
    <mesh name="visor" file="visor.stl" scale="0.001 0.001 0.001"/>
    <mesh name="antenna_left" file="antenna_left.stl" scale="0.001 0.001 0.001"/>
    <mesh name="antenna_right" file="antenna_right.stl" scale="0.001 0.001 0.001"/>
    <mesh name="tip_left" file="tip_left.stl" scale="0.001 0.001 0.001"/>
    <mesh name="tip_right" file="tip_right.stl" scale="0.001 0.001 0.001"/>
  </asset>
  <worldbody>
    <light pos="0 -0.35 0.45" dir="0 0.5 -0.7" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="1 1 0.01" material="floor_mat" friction="0.9 0.02 0.002"/>
    <body name="pebble_visual" mocap="true">
      <geom type="mesh" mesh="shell" material="shell_mat" contype="0" conaffinity="0"/>
      <geom type="mesh" mesh="visor" material="visor_mat" contype="0" conaffinity="0"/>
      <geom type="mesh" mesh="antenna_left" material="antenna_mat" contype="0" conaffinity="0"/>
      <geom type="mesh" mesh="antenna_right" material="antenna_mat" contype="0" conaffinity="0"/>
      <geom type="mesh" mesh="tip_left" material="tip_mat" contype="0" conaffinity="0"/>
      <geom type="mesh" mesh="tip_right" material="tip_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
